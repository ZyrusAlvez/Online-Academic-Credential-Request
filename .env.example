# local | staging | production
APP_ENV=local
APP_KEY=

DB_USERNAME=uphsl_tracker
DB_PASSWORD=

# Payment receipts: local (storage/app/private/<env>) or r2 (docs/setup-mail-and-storage.md)
RECEIPTS_DISK=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Email through Gmail (docs/setup-mail-and-storage.md). Without these, email is written to
# storage/logs/laravel.log. Locally, every email is redirected to MAIL_USERNAME's inbox.
MAIL_USERNAME=
MAIL_PASSWORD=

# First registrar account, created by the seeder if it doesn't exist yet.
INITIAL_REGISTRAR_EMAIL=
INITIAL_REGISTRAR_PASSWORD=
