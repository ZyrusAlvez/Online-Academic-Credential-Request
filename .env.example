# local | staging | production
APP_ENV=local
APP_KEY=

DB_USERNAME=uphsl_tracker
DB_PASSWORD=

# Payment receipts: local (storage/app/private/<env>) or r2 (Cloudflare R2)
RECEIPTS_DISK=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Email through Gmail (MAIL_PASSWORD is a Google App Password). Without these, email is written to
# storage/logs/laravel.log. Locally, every email is redirected to MAIL_USERNAME's inbox.
MAIL_USERNAME=
MAIL_PASSWORD=

# Text messages to requesters: IPROG SMS for +63 numbers, Telnyx for the rest. Without a provider's
# key, its texts are written to storage/logs/laravel.log. Outside production every text goes to
# SMS_REDIRECT_TO (an E.164 number, e.g. +639171234567), or only to the log when it is blank.
IPROG_API_TOKEN=
TELNYX_API_KEY=
TELNYX_FROM=
TELNYX_MESSAGING_PROFILE_ID=
SMS_REDIRECT_TO=

# Sign in with Google: an OAuth client from Google Cloud Console, with the authorized redirect URI
# <APP_URL>/auth/google/callback. Without these, the Google button is hidden.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# First admin account, created by the seeder if it doesn't exist yet. It is the only seeded
# account: sign in with it to create the registrar and department staff accounts.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
