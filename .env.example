APP_NAME="UPHSL Credential Tracker"
# staging | production. `composer dev` runs staging; `composer prod` runs production.
APP_ENV=staging
APP_KEY=
APP_URL_STAGING=http://localhost:8000
APP_URL_PRODUCTION=http://localhost:8001

APP_TIMEZONE=Asia/Manila
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE_STAGING=uphsl_credential_tracker_staging
DB_DATABASE_PRODUCTION=uphsl_credential_tracker
DB_USERNAME=uphsl_tracker
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

# Email. Staging always writes emails to storage/logs/laravel.log; these settings are used by
# production. Gmail setup: docs/setup-mail-and-storage.md (switch MAIL_MAILER to smtp when done).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=   # leave empty to send from MAIL_USERNAME
MAIL_FROM_NAME="UPHSL Office of the Registrar"

# Payment receipts: local (storage/app/private/<env>) or r2 (Cloudflare R2, one private bucket,
# folders staging/ and production/). R2 setup: docs/setup-mail-and-storage.md
RECEIPTS_DISK=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT="https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com"

VITE_APP_NAME="${APP_NAME}"

# First registrar account, created when the production database is set up.
# In staging its password is always "password".
INITIAL_REGISTRAR_EMAIL=registrar@uphsl.edu.ph
INITIAL_REGISTRAR_PASSWORD=
