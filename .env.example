# local | staging | production
APP_ENV=local
APP_KEY=

DB_USERNAME=uphsl_tracker
DB_PASSWORD=

# Payment receipts: local (storage/app/private/<env>) or r2 (docs/setup-mail-and-storage.md)
RECEIPTS_DISK=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Production only. Local and staging always write email to storage/logs/laravel.log.
MAIL_USERNAME=
MAIL_PASSWORD=
INITIAL_REGISTRAR_PASSWORD=
